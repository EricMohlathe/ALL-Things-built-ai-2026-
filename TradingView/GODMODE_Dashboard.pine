//@version=5
// ============================================================================
//  GODMODE Dashboard  ⚡  — TradingView (Pine v5)
//  One indicator that VISUALISES every GODMODE archetype (GM01–GM26) as a
//  toggleable, colour-coded module + a live dashboard, signals, zones, sessions
//  and alerts. TradingView-grade theme. Mirror of the MT5/cTrader dashboards.
//
//  Modules (each maps to an EA):
//   Trend(GM22) · VWAP±SD(GM07) · Structure BOS/CHoCH(GM16) · FVG(GM03/11)
//   OrderBlock(GM04/05) · Supply&Demand(GM15) · Sweep/SFP/TurtleSoup(GM02/14/21)
//   OTE-Fib(GM12) · Sessions/SilverBullet(GM01/11) · Gap/CE(GM20/23)
//   PrevDay/Week levels(GM21) · Momentum(GM08) · Confluence score(GM26)
// ============================================================================
indicator("GODMODE Dashboard ⚡", overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=500)

// ---------------------------------------------------------------- THEME
grpT = "🎨 Theme"
cBull  = input.color(#00E5A0, "Bullish",  group=grpT, inline="c1")
cBear  = input.color(#FF4D6D, "Bearish",  group=grpT, inline="c1")
cNeut  = input.color(#5B8DEF, "Neutral",  group=grpT, inline="c2")
cGold  = input.color(#FFD24C, "Accent",   group=grpT, inline="c2")
cText  = input.color(#E6EDF3, "Text",     group=grpT, inline="c3")
cPanel = input.color(#0B1220, "Panel",    group=grpT, inline="c3")
zoneTr = input.int(82, "Zone transparency", minval=50, maxval=95, group=grpT)
cDemand = color.new(cBull, zoneTr)
cSupply = color.new(cBear, zoneTr)
cFvgB   = color.new(#5B8DEF, zoneTr)
cFvgS   = color.new(#B57EDC, zoneTr)
cOte    = color.new(cGold, zoneTr)

// ---------------------------------------------------------------- TOGGLES
grpM = "🧩 Modules (each = one EA)"
useTrend = input.bool(true,  "Trend EMA (GM22)",            group=grpM)
useVwap  = input.bool(true,  "VWAP ± StdDev bands (GM07)",  group=grpM)
useStruct= input.bool(true,  "Structure BOS / CHoCH (GM16)",group=grpM)
useSwing = input.bool(true,  "Swing fractals",              group=grpM)
useFvg   = input.bool(true,  "Fair Value Gaps (GM03/11)",   group=grpM)
useOB    = input.bool(true,  "Order Blocks (GM04/05)",      group=grpM)
useSD    = input.bool(true,  "Supply & Demand (GM15)",      group=grpM)
useSfp   = input.bool(true,  "Sweep / SFP / Turtle (GM02/14/21)", group=grpM)
useOte   = input.bool(true,  "OTE Fib 0.62–0.79 (GM12)",    group=grpM)
useSess  = input.bool(true,  "Sessions / Silver Bullet (GM01/11)", group=grpM)
usePDL   = input.bool(true,  "Prev-Day / Week levels (GM21)",group=grpM)
useGap   = input.bool(true,  "Opening Gap / CE (GM20/23)",  group=grpM)
useSignal= input.bool(true,  "Confluence signals + alerts (GM26)", group=grpM)

// ---------------------------------------------------------------- PARAMS
grpP = "⚙️ Params"
emaLen   = input.int(50,  "Trend EMA",        group=grpP)
fastLen  = input.int(20,  "Fast EMA",         group=grpP)
vwapMult = input.float(2.0,"VWAP SD mult",    group=grpP, step=0.1)
vwapDevL = input.int(100, "VWAP SD length",   group=grpP)
swLeg    = input.int(8,   "Swing strength",   group=grpP)
zoneLB   = input.int(30,  "Zone lookback",    group=grpP)
dispMult = input.float(1.0,"Displacement ATR",group=grpP, step=0.1)
oteLB    = input.int(20,  "OTE swing lookback",group=grpP)
atrLen   = input.int(14,  "ATR length",       group=grpP)
minLayers= input.int(4,   "Confluence min layers", group=grpP, minval=1, maxval=8)

atr = ta.atr(atrLen)

// ================================================================ TREND
ema  = ta.ema(close, emaLen)
fast = ta.ema(close, fastLen)
emaCol = ema > ema[1] ? cBull : cBear
plot(useTrend ? ema : na,  "Trend EMA", color=emaCol, linewidth=2)
plot(useTrend ? fast : na, "Fast EMA",  color=color.new(cNeut, 20), linewidth=1)
biasTrend = close > ema ? 1 : close < ema ? -1 : 0

// ================================================================ VWAP ± SD
vwapVal = ta.vwap(hlc3)
dev = vwapMult * ta.stdev(close, vwapDevL)
upBand = vwapVal + dev
dnBand = vwapVal - dev
plot(useVwap ? vwapVal : na, "VWAP", color=cGold, linewidth=2)
pU = plot(useVwap ? upBand : na, "VWAP +SD", color=color.new(cNeut,40))
pD = plot(useVwap ? dnBand : na, "VWAP -SD", color=color.new(cNeut,40))
fill(pU, pD, color=color.new(cNeut, 92), title="VWAP band")
biasVwap = useVwap and close < dnBand ? 1 : useVwap and close > upBand ? -1 : 0

// ================================================================ SWINGS + STRUCTURE
ph = ta.pivothigh(swLeg, swLeg)
pl = ta.pivotlow(swLeg, swLeg)
var float lastPH = na
var float lastPL = na
var float prevPH = na
var float prevPL = na
if not na(ph)
    prevPH := lastPH
    lastPH := ph
    if useSwing
        label.new(bar_index - swLeg, ph, "", style=label.style_circle, color=color.new(cBear,30), size=size.tiny)
if not na(pl)
    prevPL := lastPL
    lastPL := pl
    if useSwing
        label.new(bar_index - swLeg, pl, "", style=label.style_circle, color=color.new(cBull,30), size=size.tiny)

bosUp = not na(lastPH) and ta.crossover(close, lastPH)
bosDn = not na(lastPL) and ta.crossunder(close, lastPL)
chochUp = bosUp and not na(prevPH) and lastPH < prevPH    // break up after lower highs
chochDn = bosDn and not na(prevPL) and lastPL > prevPL    // break dn after higher lows
if useStruct and bosUp
    label.new(bar_index, low, chochUp ? "CHoCH▲" : "BOS▲", yloc=yloc.belowbar, style=label.style_label_up, color=color.new(cBull,20), textcolor=cText, size=size.small)
if useStruct and bosDn
    label.new(bar_index, high, chochDn ? "CHoCH▼" : "BOS▼", yloc=yloc.abovebar, style=label.style_label_down, color=color.new(cBear,20), textcolor=cText, size=size.small)
biasStruct = bosUp ? 1 : bosDn ? -1 : 0

// ================================================================ FVG (3-bar imbalance)
bullFvg = low > high[2]
bearFvg = high < low[2]
if useFvg and barstate.isconfirmed and bullFvg
    box.new(bar_index[1], low, bar_index + 6, high[2], border_color=color.new(cNeut,40), bgcolor=cFvgB)
if useFvg and barstate.isconfirmed and bearFvg
    box.new(bar_index[1], low[2], bar_index + 6, high, border_color=color.new(#B57EDC,40), bgcolor=cFvgS)
biasFvg = bullFvg ? 1 : bearFvg ? -1 : 0

// ================================================================ ORDER BLOCK + SUPPLY/DEMAND
bullDisp = close - open > dispMult * atr
bearDisp = open - close > dispMult * atr
// OB = last opposite candle before displacement; S&D base = small-range candle before displacement
if useOB and barstate.isconfirmed and bullDisp and close[1] < open[1]
    box.new(bar_index[1], high[1], bar_index + 6, low[1], border_color=color.new(cBull,30), bgcolor=cDemand, text="OB", text_color=color.new(cText,30), text_size=size.tiny)
if useOB and barstate.isconfirmed and bearDisp and close[1] > open[1]
    box.new(bar_index[1], high[1], bar_index + 6, low[1], border_color=color.new(cBear,30), bgcolor=cSupply, text="OB", text_color=color.new(cText,30), text_size=size.tiny)
baseSmall = (high[1] - low[1]) < 0.6 * atr
if useSD and barstate.isconfirmed and bullDisp and baseSmall
    box.new(bar_index[1], high[1], bar_index + 6, low[1], border_color=color.new(cBull,50), bgcolor=cDemand, text="D", text_color=color.new(cText,30), text_size=size.tiny)
if useSD and barstate.isconfirmed and bearDisp and baseSmall
    box.new(bar_index[1], high[1], bar_index + 6, low[1], border_color=color.new(cBear,50), bgcolor=cSupply, text="S", text_color=color.new(cText,30), text_size=size.tiny)
biasMom = bullDisp ? 1 : bearDisp ? -1 : 0

// ================================================================ SWEEP / SFP / TURTLE SOUP
sfpBear = useSfp and not na(lastPH) and high > lastPH and close < lastPH
sfpBull = useSfp and not na(lastPL) and low  < lastPL and close > lastPL
if sfpBear
    label.new(bar_index, high, "SFP", yloc=yloc.abovebar, style=label.style_xcross, color=cBear, textcolor=cText, size=size.tiny)
if sfpBull
    label.new(bar_index, low, "SFP", yloc=yloc.belowbar, style=label.style_xcross, color=cBull, textcolor=cText, size=size.tiny)
biasSfp = sfpBull ? 1 : sfpBear ? -1 : 0

// ================================================================ OTE (Fib 0.62–0.79)
oteHi = ta.highest(high, oteLB)
oteLo = ta.lowest(low, oteLB)
oteRng = oteHi - oteLo
var box oteBoxL = na
var box oteBoxS = na
if useOte and oteRng > 0
    // bullish discount OTE (retrace of an up-leg)
    oteLtop = oteHi - 0.62 * oteRng
    oteLbot = oteHi - 0.79 * oteRng
    box.delete(oteBoxL)
    oteBoxL := close > ema ? box.new(bar_index - oteLB, oteLtop, bar_index + 4, oteLbot, border_color=na, bgcolor=cOte) : na
biasOte = useOte and oteRng > 0 and close <= (oteHi - 0.62*oteRng) and close >= (oteHi - 0.79*oteRng) and close > ema ? 1 : useOte and oteRng > 0 and close >= (oteLo + 0.62*oteRng) and close <= (oteLo + 0.79*oteRng) and close < ema ? -1 : 0

// ================================================================ SESSIONS (killzones / Silver Bullet)
grpS = "🕒 Sessions (exchange tz)"
sAsia = input.session("0000-0600", "Asia",       group=grpS)
sLon  = input.session("0700-1000", "London KZ",  group=grpS)
sNY   = input.session("1200-1500", "NY KZ",      group=grpS)
inAsia = not na(time(timeframe.period, sAsia))
inLon  = not na(time(timeframe.period, sLon))
inNY   = not na(time(timeframe.period, sNY))
bgcolor(useSess and inAsia ? color.new(cNeut, 94) : na, title="Asia")
bgcolor(useSess and inLon  ? color.new(cBull, 92) : na, title="London KZ")
bgcolor(useSess and inNY   ? color.new(cGold, 92) : na, title="NY KZ")
inKZ = inLon or inNY

// ================================================================ PREV-DAY / WEEK LEVELS
pdh = request.security(syminfo.tickerid, "D", high[1], lookahead=barmerge.lookahead_on)
pdl = request.security(syminfo.tickerid, "D", low[1],  lookahead=barmerge.lookahead_on)
pdc = request.security(syminfo.tickerid, "D", close[1],lookahead=barmerge.lookahead_on)
dOpen = request.security(syminfo.tickerid, "D", open,  lookahead=barmerge.lookahead_on)
plot(usePDL ? pdh : na, "PDH", color=color.new(cBear,30), style=plot.style_stepline)
plot(usePDL ? pdl : na, "PDL", color=color.new(cBull,30), style=plot.style_stepline)

// ================================================================ GAP / CE
gap = dOpen - pdc
gapThr = 0.5 * atr
gapUp = useGap and gap > gapThr
gapDn = useGap and gap < -gapThr
ce = (pdc + dOpen) / 2.0
plot(useGap and (gapUp or gapDn) ? ce : na, "Gap CE", color=color.new(cGold,20), style=plot.style_circles)
biasGap = gapUp and low <= ce and close >= ce ? 1 : gapDn and high >= ce and close <= ce ? -1 : 0

// ================================================================ CONFLUENCE SCORE
longN = (biasTrend>0?1:0) + (biasVwap>0?1:0) + (biasStruct>0?1:0) + (biasFvg>0?1:0) + (biasMom>0?1:0) + (biasSfp>0?1:0) + (biasOte>0?1:0) + (biasGap>0?1:0) + (inKZ?1:0)
shortN= (biasTrend<0?1:0) + (biasVwap<0?1:0) + (biasStruct<0?1:0) + (biasFvg<0?1:0) + (biasMom<0?1:0) + (biasSfp<0?1:0) + (biasOte<0?1:0) + (biasGap<0?1:0) + (inKZ?1:0)
goLong  = useSignal and longN >= minLayers and longN > shortN
goShort = useSignal and shortN >= minLayers and shortN > longN
plotshape(goLong  and not goLong[1],  "GODMODE LONG",  style=shape.triangleup,   location=location.belowbar, color=cBull, size=size.small, text="GODMODE", textcolor=cBull)
plotshape(goShort and not goShort[1], "GODMODE SHORT", style=shape.triangledown, location=location.abovebar, color=cBear, size=size.small, text="GODMODE", textcolor=cBear)
alertcondition(goLong  and not goLong[1],  "GODMODE LONG",  "⚡ GODMODE LONG {{ticker}} {{interval}} — confluence stacked")
alertcondition(goShort and not goShort[1], "GODMODE SHORT", "⚡ GODMODE SHORT {{ticker}} {{interval}} — confluence stacked")
alertcondition(sfpBull, "SFP Bull", "SFP reclaim (bull) {{ticker}}")
alertcondition(sfpBear, "SFP Bear", "SFP reclaim (bear) {{ticker}}")
alertcondition(bosUp,  "BOS Up",  "Break of structure ▲ {{ticker}}")
alertcondition(bosDn,  "BOS Down","Break of structure ▼ {{ticker}}")

// "Animated" live bias tag that follows price every tick on the last bar
var label liveTag = na
if barstate.islast
    label.delete(liveTag)
    sc = goLong ? longN : goShort ? shortN : math.max(longN, shortN)
    bcol = longN > shortN ? cBull : shortN > longN ? cBear : cNeut
    liveTag := label.new(bar_index + 3, close, "► " + (longN>shortN?"LONG ":shortN>longN?"SHORT ":"FLAT ") + str.tostring(math.max(longN,shortN)) + "/9", style=label.style_label_left, color=color.new(bcol, 10), textcolor=#FFFFFF, size=size.normal)

// ================================================================ DASHBOARD
f_dot(b) => b ? "●" : "○"
f_bias(v) => v > 0 ? "LONG" : v < 0 ? "SHORT" : "—"
f_bcol(v) => v > 0 ? cBull : v < 0 ? cBear : color.new(cText, 40)

var table dash = table.new(position.top_right, 3, 15, bgcolor=color.new(cPanel, 8), frame_color=color.new(cNeut, 40), frame_width=1, border_color=color.new(cNeut, 70), border_width=1)
if barstate.islast
    table.cell(dash, 0, 0, "⚡ GODMODE", text_color=cGold, text_size=size.normal, bgcolor=color.new(cPanel,0))
    table.cell(dash, 1, 0, "on",  text_color=color.new(cText,30), text_size=size.tiny, bgcolor=color.new(cPanel,0))
    table.cell(dash, 2, 0, "bias",text_color=color.new(cText,30), text_size=size.tiny, bgcolor=color.new(cPanel,0))
    r_name = array.from("Trend GM22","VWAP GM07","Struct GM16","FVG GM03","OB GM04/05","S&D GM15","Sweep GM14","OTE GM12","Session GM11","Gap GM20","Momentum GM08")
    r_on   = array.from(useTrend,useVwap,useStruct,useFvg,useOB,useSD,useSfp,useOte,useSess,useGap,true)
    r_bias = array.from(biasTrend,biasVwap,biasStruct,biasFvg,biasMom,biasMom,biasSfp,biasOte, inKZ?1:0, biasGap, biasMom)
    for i = 0 to array.size(r_name) - 1
        row = i + 1
        table.cell(dash, 0, row, array.get(r_name,i), text_color=cText, text_size=size.tiny, text_halign=text.align_left)
        table.cell(dash, 1, row, f_dot(array.get(r_on,i)), text_color=array.get(r_on,i)?cBull:color.new(cText,60), text_size=size.tiny)
        bv = array.get(r_bias,i)
        table.cell(dash, 2, row, f_bias(bv), text_color=f_bcol(bv), text_size=size.tiny)
    // score row
    scol = longN>shortN?cBull:shortN>longN?cBear:cNeut
    table.cell(dash, 0, 12, "SCORE", text_color=cGold, text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 1, 12, "L"+str.tostring(longN), text_color=cBull, text_size=size.small)
    table.cell(dash, 2, 12, "S"+str.tostring(shortN), text_color=cBear, text_size=size.small)
    sig = goLong?"⚡ LONG":goShort?"⚡ SHORT":"WAIT"
    table.cell(dash, 0, 13, "SIGNAL", text_color=cText, text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 1, 13, sig, text_color=scol, text_size=size.small, bgcolor=color.new(scol, 80))
    table.cell(dash, 2, 13, "≥"+str.tostring(minLayers), text_color=color.new(cText,30), text_size=size.tiny)
    table.cell(dash, 0, 14, str.tostring(close, format.mintick), text_color=color.new(cText,20), text_size=size.tiny, text_halign=text.align_left)
    table.cell(dash, 1, 14, inKZ?"KZ":"—", text_color=inKZ?cGold:color.new(cText,60), text_size=size.tiny)
    table.cell(dash, 2, 14, "ATR "+str.tostring(atr, format.mintick), text_color=color.new(cText,40), text_size=size.tiny)
