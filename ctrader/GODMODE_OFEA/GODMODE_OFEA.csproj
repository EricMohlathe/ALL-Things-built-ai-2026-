<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>GodmodeOfea</RootNamespace>
    <AssemblyName>GODMODE_OFEA</AssemblyName>
    <!-- cTrader cBots compile to a .NET class library. The cTrader Desktop IDE
         packages the resulting .dll plus a manifest into the .algo file. The
         GitHub Actions workflow does the same packaging step manually. -->
    <OutputType>Library</OutputType>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <!-- Modern cTrader Automate API (formerly cAlgo.API). The version pin should
         match the cTrader Desktop version your broker ships. Operators may need
         to bump this if they upgrade cTrader.

         If your broker still uses the legacy cAlgo.API package, swap the
         PackageReference to:
           <PackageReference Include="cAlgo.API" Version="1.0.6" />
    -->
    <PackageReference Include="cTrader.Automate" Version="1.0.0" />
  </ItemGroup>

  <!-- Sources (GODMODE_OFEA.cs and Modules/**/*.cs) are auto-included by the
       SDK because EnableDefaultCompileItems=true. Do NOT add explicit
       <Compile Include ... /> entries here or the build will fail with
       'Duplicate Compile items were included'. -->

</Project>
