// 02_Enhanced_DeltaPane.pine — bar-delta histogram + CVD + climax + regime
//@version=6
indicator("GODMODE Delta Enhanced", "OFEA·Δ+", overlay=false, format=format.volume)

lookback = input.int(20, "Lookback")
climaxZ  = input.float(2.0, "Climax Z")
flipBars = input.int(3, "Δ flip lookback")
showDiv  = input.bool(true, "Show CVD/price divergence arrows")

// close-position-proxy delta (works on every symbol in Pine; no library deps)
rng  = high - low
bw   = rng > 0 ? (close - low) / rng : 0.5
bd   = volume * (bw - (1.0 - bw))

isNewDay = ta.change(time("D")) != 0
var float cvd = 0.0
// Use nz(cvd[1], 0.0) for explicit prior-bar reference + na safety.
cvd := isNewDay ? bd : nz(cvd[1], 0.0) + bd

mu  = ta.sma(bd, lookback)
sd  = ta.stdev(bd, lookback)
z   = sd > 0 ? (bd - mu) / sd : 0
climax = math.abs(z) >= climaxZ

// delta flip detection (last `flipBars` bars) — early-exit on first flip
flipped = false
s1 = math.sign(bd)
for i = 1 to flipBars
    s0 = math.sign(bd[i])
    if s1 != 0 and s0 != 0 and s1 != s0
        flipped := true
        break

// CVD-price divergence detection
pLL = ta.lowest(low,  20) == low
pHH = ta.highest(high, 20) == high
cLL = ta.lowest(cvd, 20) == cvd
cHH = ta.highest(cvd, 20) == cvd
bullDiv = pLL and not cLL
bearDiv = pHH and not cHH

plot(bd > 0 ? bd : 0,  "Δ+", color=color.lime,   style=plot.style_columns, linewidth=3)
plot(bd < 0 ? bd : 0,  "Δ-", color=color.red,    style=plot.style_columns, linewidth=3)
plot(cvd,              "CVD", color=color.yellow, linewidth=2)
plot(climax ? bd : na, "Climax", color=color.fuchsia, style=plot.style_circles, linewidth=4)
hline(0, color=color.new(color.gray, 50))
plotshape(showDiv and bullDiv, "Bull Div", location=location.bottom, style=shape.triangleup,   color=color.lime,   size=size.small, text="DIV")
plotshape(showDiv and bearDiv, "Bear Div", location=location.top,    style=shape.triangledown, color=color.red,    size=size.small, text="DIV")

var table info = table.new(position.top_right, 2, 5, bgcolor=color.new(#0b0e14, 12), border_width=1)
if barstate.islast
    table.cell(info, 0, 0, "BAR Δ",  text_color=color.silver, text_size=size.small)
    table.cell(info, 1, 0, str.tostring(bd, "0"), text_color=color.white,  text_size=size.small)
    table.cell(info, 0, 1, "Z",      text_color=color.silver, text_size=size.small)
    table.cell(info, 1, 1, str.tostring(z, "0.00"), text_color=climax ? color.fuchsia : color.white, text_size=size.small)
    table.cell(info, 0, 2, "CVD",    text_color=color.silver, text_size=size.small)
    table.cell(info, 1, 2, str.tostring(cvd, "0"), text_color=color.yellow, text_size=size.small)
    table.cell(info, 0, 3, "Δ flip", text_color=color.silver, text_size=size.small)
    table.cell(info, 1, 3, flipped ? "YES" : "no", text_color=flipped ? color.lime : color.gray, text_size=size.small)
    table.cell(info, 0, 4, "Div",    text_color=color.silver, text_size=size.small)
    table.cell(info, 1, 4, bullDiv ? "Bull" : bearDiv ? "Bear" : "-", text_color=bullDiv ? color.lime : bearDiv ? color.red : color.gray, text_size=size.small)
