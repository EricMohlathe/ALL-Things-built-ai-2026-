// 07_Enhanced_SetupCard.pine — buy/sell + Entry/SL1-3/TP1-3 card
//@version=6
indicator("GODMODE Setup Card", "OFEA·Card", overlay=true, max_lines_count=50, max_labels_count=50)

dir    = input.string("LONG", "Direction", options=["LONG","SHORT"])
entry  = input.price(0.0, "Entry (click chart)", confirm=true)
useATR = input.bool(true, "Auto SL/TP from ATR(14)")
atrMul1 = input.float(1.0, "ATR × for SL1 / TP1")
atrMul2 = input.float(1.5, "ATR × for SL2 / TP2")
atrMul3 = input.float(2.0, "ATR × for SL3 / TP3 (SL3 only); TP3 = ATR × 3.0")
project = input.int(20, "Project bars")

atrV   = ta.atr(14)
isLong = dir == "LONG"
sign   = isLong ? 1 : -1

sl1 = useATR ? entry - sign * atrV * atrMul1 : na
sl2 = useATR ? entry - sign * atrV * atrMul2 : na
sl3 = useATR ? entry - sign * atrV * atrMul3 : na
tp1 = useATR ? entry + sign * atrV * 1.0 : na
tp2 = useATR ? entry + sign * atrV * 2.0 : na
tp3 = useATR ? entry + sign * atrV * 3.0 : na

draw(p, name, col, style) =>
    if not na(p) and entry > 0
        line.new(bar_index - 1, p, bar_index + project, p, color=col, style=style, width=2)
        label.new(bar_index + project, p, name + " " + str.tostring(p, format.mintick), textcolor=col, style=label.style_label_left, color=color.new(col, 80))

if entry > 0 and barstate.islast
    draw(entry, "ENTRY", color.white, line.style_solid)
    draw(sl1, "SL1", color.red,    line.style_dashed)
    draw(sl2, "SL2", color.red,    line.style_dotted)
    draw(sl3, "SL3", color.red,    line.style_dotted)
    draw(tp1, "TP1", color.lime,   line.style_dashed)
    draw(tp2, "TP2", color.lime,   line.style_dashed)
    draw(tp3, "TP3", color.lime,   line.style_solid)

var table card = table.new(position.bottom_left, 2, 8, bgcolor=color.new(#0b0e14, 0), border_width=1)
if barstate.islast and entry > 0
    table.cell(card, 0, 0, "SETUP",  bgcolor=color.new(#6aa9ff, 70), text_color=color.white, text_size=size.normal)
    table.cell(card, 1, 0, dir,      bgcolor=isLong?color.lime:color.red, text_color=color.black, text_size=size.normal)
    table.cell(card, 0, 1, "ENTRY",  text_color=color.silver)
    table.cell(card, 1, 1, str.tostring(entry, format.mintick), text_color=color.white)
    table.cell(card, 0, 2, "TP1",    text_color=color.silver)
    table.cell(card, 1, 2, str.tostring(tp1, format.mintick),   text_color=color.lime)
    table.cell(card, 0, 3, "TP2",    text_color=color.silver)
    table.cell(card, 1, 3, str.tostring(tp2, format.mintick),   text_color=color.lime)
    table.cell(card, 0, 4, "TP3",    text_color=color.silver)
    table.cell(card, 1, 4, str.tostring(tp3, format.mintick),   text_color=color.lime)
    table.cell(card, 0, 5, "SL1",    text_color=color.silver)
    table.cell(card, 1, 5, str.tostring(sl1, format.mintick),   text_color=color.red)
    table.cell(card, 0, 6, "SL2",    text_color=color.silver)
    table.cell(card, 1, 6, str.tostring(sl2, format.mintick),   text_color=color.red)
    table.cell(card, 0, 7, "SL3",    text_color=color.silver)
    table.cell(card, 1, 7, str.tostring(sl3, format.mintick),   text_color=color.red)
